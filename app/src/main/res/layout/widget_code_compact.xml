<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 verification-code widget: merchant + code + one-line excerpt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_code_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_shield"
            android:contentDescription="@string/widget_code_icon_desc" />

        <TextView
            android:id="@+id/widget_code_merchant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_code_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_accent"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/widget_code_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary" />
</LinearLayout>
