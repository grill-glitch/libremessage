<?xml version="1.0" encoding="utf-8"?>
<!-- Message-list widget: header + fixed conversation rows + new-message FAB.
     Fixed rows (not a ListView) so each row can carry its own click
     PendingIntent — some launchers drop fill-in extras on ListView items. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Card content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg">

        <!-- Header: app title, tap opens the app -->
        <LinearLayout
            android:id="@+id/widget_list_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_widget_chat"
                android:contentDescription="@string/widget_list_icon_desc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widget_list_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider" />

        <!-- 6 conversation rows with independent ids (fixed layout, each row
             gets its own click PendingIntent). -->
        <include layout="@layout/widget_list_row0" />
        <include layout="@layout/widget_list_row1" />
        <include layout="@layout/widget_list_row2" />
        <include layout="@layout/widget_list_row3" />
        <include layout="@layout/widget_list_row4" />
        <include layout="@layout/widget_list_row5" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/widget_list_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_list_empty"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <!-- New-message FAB, bottom-right (rounded square, MD3 colors) -->
    <ImageButton
        android:id="@+id/widget_new_msg"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:src="@drawable/ic_widget_compose"
        android:background="@drawable/widget_fab_bg"
        android:contentDescription="@string/widget_new_msg"
        android:scaleType="centerInside"
        android:padding="9dp"
        android:stateListAnimator="@null" />
</FrameLayout>
