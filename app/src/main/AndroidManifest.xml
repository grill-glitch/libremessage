<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS: read the provider, receive incoming, send outgoing -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Contacts: resolve sender names / avatars -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- SIM cards: enumerate active subscriptions for the send-with-SIM picker -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Android 13+ notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- MMS / cell broadcast: signature permissions. Required by the
         default-SMS-app role: the system (RoleManagerService) auto-grants
         them to the role holder, and SmsApplication's exclusive-appops
         check requires them ALLOWED. Without these the app is rejected
         as default SMS app. -->
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CELL_BROADCASTS" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibrelabMessaging">

        <!-- Launcher + ACTION_SENDTO (smsto:) entry point — required for default SMS app status -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher long-press shortcuts: new message / codes / pickups -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
            </intent-filter>
            <!-- Share target: appears in the system share sheet so other
                 apps can send text / images / files to a conversation. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Verification-code card widget (2×1 / 2×3). -->
        <receiver
            android:name=".CodeWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/code_widget_info" />
        </receiver>

        <!-- Recent-conversations widget (4×2). -->
        <receiver
            android:name=".ListWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/list_widget_info" />
        </receiver>

        <!-- Incoming SMS: SMS_RECEIVED reaches every receiver, SMS_DELIVER is
             routed exclusively to the default SMS app. Both land here. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- MMS: required by the system's default-SMS-app role qualification
             (WAP_PUSH_DELIVER + BROADCAST_WAP_PUSH + mms mimeType). This app
             is SMS-only, so received MMS is surfaced as a notification. -->
        <receiver
            android:name=".MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_RECEIVED" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Headless "respond via message" entry point. The system looks up a
             service with exactly this class name + RESPOND_VIA_MESSAGE
             intent-filter to confirm default-SMS-app capability (AOSP
             SmsApplication.isComplete). -->
        <service
            android:name=".HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
            </intent-filter>
        </service>

        <!-- "Copy code" quick action from the incoming-SMS notification -->
        <receiver
            android:name=".CopyCodeReceiver"
            android:exported="true" />

        <!-- Send-confirmation callback (sent PendingIntent) -->
        <receiver
            android:name=".SmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.librelab.messaging.SMS_SENT" />
            </intent-filter>
        </receiver>

        <!-- Raw PDU temp files for outbound MMS (read by the telephony stack) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
